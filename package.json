{
  "name": "opencode2-agent-model-override",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin for persistent, session-scoped agent model overrides",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidprokopec/opencode2-agent-model-override.git"
  },
  "homepage": "https://github.com/davidprokopec/opencode2-agent-model-override#readme",
  "bugs": "https://github.com/davidprokopec/opencode2-agent-model-override/issues",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "effect",
    "agent",
    "model",
    "model-routing",
    "session"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun test",
    "prepublishOnly": "bun run check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-17639",
    "@opencode-ai/schema": "0.0.0-beta-17639",
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
